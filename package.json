{
  "name": "gt2-logbook",
  "version": "0.2.0",
  "private": true,
  "description": "GT 2 Logbook: an Android app (and claude.ai Artifact) for Huawei Watch GT 2 data, with training, recovery and sleep models from the sports-science literature.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:app": "node scripts/build-app.mjs",
    "android:sync": "node scripts/build-app.mjs && cap sync android",
    "android:apk": "node scripts/build-app.mjs && cap sync android && cd android && ./gradlew assembleRelease",
    "test": "node --test \"test/*.test.mjs\"",
    "fixture": "node scripts/make-fixture.mjs",
    "test:e2e": "node test/e2e/run.mjs",
    "test:e2e:app": "node test/e2e/app.mjs",
    "lint": "eslint src scripts test"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@zip.js/zip.js": "2.8.61",
    "d3": "7.9.0",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "playwright": "1.56.1"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/share": "8.0.2",
    "@capgo/capacitor-health": "8.11.4"
  }
}
